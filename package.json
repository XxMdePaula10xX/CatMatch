{
  "name": "cat-match",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cat Match — Match-3 de Gatinhos (MVP)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
