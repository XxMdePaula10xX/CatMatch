rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global ranking: anyone can read. You can only write a score document whose
    // id belongs to you (id is "<uid>_<board>_<period>") and whose body carries
    // your uid; you can only update/delete a document you already own. Score is
    // validated to block forged/out-of-range values.
    match /scores/{docId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && docId.split('_')[0] == request.auth.uid
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 100000000;

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 100000000;

      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Cloud save: each user reads/writes/deletes only their own document.
    match /saves/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }
  }
}
